{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "serviceBus": {
            "prefetchCount": 0,
            "messageProcessingOptions": {
                "autoCompleteMessages": false,
                "maxConcurrentCalls": 1
            }
        }
    }
}
